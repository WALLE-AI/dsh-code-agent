{
  "name": "@deepseek-ai/dsh-tui",
  "description": "Keyboard-first terminal UI profile for the DeepSeek Harness agent runtime",
  "version": "0.1.6",
  "private": true,
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "bin": {
    "dshcodecli": "bin/dshcodecli.mjs"
  },
  "main": "lib/plugin.js",
  "types": "lib/types/plugin.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/plugin.d.ts",
      "development": "./src/plugin.ts",
      "default": "./lib/plugin.js"
    },
    "./startup": {
      "types": "./lib/types/startup.d.ts",
      "development": "./src/startup.ts",
      "default": "./lib/startup.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "bin/*.mjs",
    "lib/**/*.js",
    "lib/types/**/*.d.ts",
    "src/**/*.ts",
    "src/**/*.tsx",
    "completions/*",
    "cordis.patch.yml",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "dependencies": {
    "commander": "^14.0.0",
    "ink": "5.2.1",
    "react": "18.3.1"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-agent": ">=0.1.0-rc.5",
    "@deepseek-ai/dsh-llm": ">=0.1.0-rc.5",
    "@deepseek-ai/dsh-session": ">=0.1.0-rc.5"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-agent": {
      "optional": true
    },
    "@deepseek-ai/dsh-llm": {
      "optional": true
    },
    "@deepseek-ai/dsh-session": {
      "optional": true
    }
  }
}
